# Runtime
NODE_ENV=development
PSD_APP_URL=http://localhost:3000
PSD_DATA_MODE=demo

# Authentication: demo | google
AUTH_MODE=demo
ALLOW_DEMO_AUTH=true
AUTH_SECRET=replace-with-at-least-32-random-bytes
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_ALLOWED_EMAILS=
AUTH_ALLOWED_DOMAINS=

# Database
DATABASE_URL=postgresql://psd:psd@localhost:5432/psd_system?schema=public

# Telemetry
ALLOW_DEMO_INGEST=true
PSD_DEMO_INGEST_TOKEN=demo-only-change-me
TELEMETRY_AUTH_MODE=bearer
TELEMETRY_MAX_BYTES=131072
TELEMETRY_MAX_CLOCK_SKEW_SECONDS=300

# Optional vendor-neutral LLM adapter: deterministic | remote
LLM_MODE=deterministic
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
